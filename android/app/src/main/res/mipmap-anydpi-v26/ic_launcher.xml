<?xml version="1.0" encoding="utf-8"?>
<!-- Icône adaptative (Android 8+) : fond uni + bouclier (Icons.shield_rounded,
     même glyphe que le logo in-app) en foreground, masqués/animés par le
     launcher. Le fallback pré-Android 8 est mipmap-*/ic_launcher.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/rf_primary"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
